# ── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SITE_URL=https://your-domain.com

# ── Security ─────────────────────────────────────────────
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ── First admin account (created automatically on first start) ──
ADMIN_NAME=Store Owner
ADMIN_EMAIL=you@your-domain.com
ADMIN_PASSWORD=change-this-password

# ── Catalog ──────────────────────────────────────────────
# Load the sample catalog the first time the database is created.
# Set to false for a clean production start.
SEED_SAMPLE_DATA=true

# ── Database (optional) ──────────────────────────────────
# DB_FILE=./data/store.db
