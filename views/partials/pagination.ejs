<% if (typeof page !== 'undefined' && totalPages > 1) { %>
<% const mkUrl = (target) => {
     const params = new URLSearchParams();
     if (typeof extraQuery !== 'undefined' && extraQuery) {
       Object.keys(extraQuery).forEach((key) => {
         const value = extraQuery[key];
         if (value !== undefined && value !== null && value !== '') params.set(key, value);
       });
     }
     params.set('page', target);
     return `${baseUrl}?${params.toString()}`;
   }; %>
<nav class="pagination" aria-label="Pagination">
  <% if (page > 1) { %>
    <a class="page-link" href="<%= mkUrl(page - 1) %>" rel="prev">Previous</a>
  <% } else { %>
    <span class="page-link is-disabled">Previous</span>
  <% } %>
  <span class="page-status">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
    <a class="page-link" href="<%= mkUrl(page + 1) %>" rel="next">Next</a>
  <% } else { %>
    <span class="page-link is-disabled">Next</span>
  <% } %>
</nav>
<% } %>
