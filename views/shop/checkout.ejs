<%- include('../partials/head', { title, metaDescription }) %>
<%- include('../partials/header') %>
<main class="section">
  <div class="wrap">
    <h1>Checkout</h1>

    <div class="checkout-layout">
      <form class="checkout-form" method="post" action="/checkout" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <fieldset class="field-group">
          <legend>Contact details</legend>
          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" value="<%= form.name || '' %>" autocomplete="name" required>
            <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" value="<%= form.email || '' %>" autocomplete="email" required>
              <% if (errors.email) { %><p class="field-error"><%= errors.email %></p><% } %>
            </div>
            <div class="field">
              <label for="phone">Phone <span class="muted">(optional)</span></label>
              <input id="phone" name="phone" type="tel" value="<%= form.phone || '' %>" autocomplete="tel">
            </div>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend>Delivery</legend>
          <div class="field">
            <label for="address">Delivery address</label>
            <textarea id="address" name="address" rows="4" autocomplete="street-address" required><%= form.address || '' %></textarea>
            <% if (errors.address) { %><p class="field-error"><%= errors.address %></p><% } %>
          </div>
          <div class="field">
            <label for="note">Delivery note <span class="muted">(optional)</span></label>
            <textarea id="note" name="note" rows="2"><%= form.note || '' %></textarea>
          </div>
        </fieldset>

        <fieldset class="field-group">
          <legend>Payment</legend>
          <% paymentMethods.forEach((method) => { %>
            <label class="radio">
              <input type="radio" name="payment_method" value="<%= method.value %>" <%= (form.paymentMethod || 'pay_on_delivery') === method.value ? 'checked' : '' %>>
              <span><%= method.label %></span>
            </label>
          <% }) %>
          <% if (errors.paymentMethod) { %><p class="field-error"><%= errors.paymentMethod %></p><% } %>
          <% if (store.payment_instructions) { %>
            <p class="muted small"><%= store.payment_instructions %></p>
          <% } %>
        </fieldset>

        <button class="btn btn-primary btn-lg btn-block" type="submit">Place order</button>
      </form>

      <aside class="summary">
        <h2>Your order</h2>
        <ul class="summary-items">
          <% cart.items.forEach((item) => { %>
            <li>
              <span class="summary-item-name"><%= item.product.name %> <span class="muted">× <%= item.quantity %></span></span>
              <span><%= money(item.lineTotalCents) %></span>
            </li>
          <% }) %>
        </ul>
        <div class="sum-row"><span>Subtotal</span><span><%= money(cart.subtotalCents) %></span></div>
        <div class="sum-row"><span>Shipping</span><span><%= cart.shippingCents === 0 ? 'Free' : money(cart.shippingCents) %></span></div>
        <div class="sum-row sum-total"><span>Total</span><span><%= money(cart.totalCents) %></span></div>
        <a class="link small" href="/cart">Edit cart</a>
      </aside>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
